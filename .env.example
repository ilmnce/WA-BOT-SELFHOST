# ============================================================
# PESONA KAHURIPAN 17 - WHATSAPP BOT CONFIGURATION
# ============================================================

# Gemini API Keys (Bisa masukkan banyak dipisah koma untuk Auto-Rotation)
# Jika Key 1 limit, otomatis skip 30 menit dan langsung pakai Key 2
GEMINI_API_KEYS=your_gemini_key_1,your_gemini_key_2

# Atau bisa juga format individual:
# GEMINI_API_KEY_1=AIzaSy...
# GEMINI_API_KEY_2=AIzaSy...
# GEMINI_API_KEY_3=AIzaSy...

# Provider fallback (opsional)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.xkiro.com/v1
DEEPSEEK_MODEL=deepseek/deepseek-v4-pro
GROQ_API_KEY=

# Dashboard (default hanya bisa dibuka dari komputer ini)
PORT=3000
HOST=127.0.0.1

# Wajib jika HOST=0.0.0.0 atau alamat jaringan lain
DASHBOARD_TOKEN=

# Operasional bot
OPERATING_TIMEZONE=Asia/Jakarta
OPERATING_START_HOUR=8
OPERATING_END_HOUR=24
MESSAGE_DEBOUNCE_MS=6000
FILTER_SAVED_CONTACTS=true
BOT_ACTIVE_AT_STARTUP=true
HISTORY_TTL_HOURS=24
